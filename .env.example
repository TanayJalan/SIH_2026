# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your environment.
# `docker compose` picks up `.env` from the repository root automatically.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
# DEBUG=true exposes /dev/simulate-time and the top-bar "Demo time" control.
# Leave false outside local demos.
DEBUG=false
# DEMO_MODE=true publishes the seeded demo accounts to the login page.
# It is rejected when ENVIRONMENT=production.
DEMO_MODE=true
SECRET_KEY=dev-only-change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=aicte
POSTGRES_PASSWORD=aicte_dev_password
POSTGRES_DB=aicte
POSTGRES_PORT=5432
# Used when running the backend directly on the host (outside Docker).
DATABASE_URL=postgresql+psycopg://aicte:aicte_dev_password@localhost:5432/aicte

# --- Mailpit / SMTP --------------------------------------------------------
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@aicte.local
# The SMTP/SMS delivery rows are skipped when this is false. In-app alerts
# continue to work, which is useful for offline demos and automated tests.
NOTIFICATIONS_ENABLED=true

# --- Alert scans -----------------------------------------------------------
# In-process APScheduler job that checks deadlines, SLAs, deficiencies,
# document expiry, scheduled inspections and escalations.
ALERT_SCAN_ENABLED=true
ALERT_SCAN_INTERVAL_MINUTES=15

# --- Ports exposed on the host --------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# --- Uploads ---------------------------------------------------------------
# Document files are stored below this directory. Inside Docker it must match
# the backend_storage volume mount.
STORAGE_DIR=/storage

# --- Compliance monitoring -------------------------------------------------
# Nightly in-process APScheduler job (UTC hour). Disable when running a
# one-off process or when evaluations are triggered externally.
COMPLIANCE_MONITOR_ENABLED=true
COMPLIANCE_MONITOR_HOUR=2

# --- Demo seed (clearly fictional data only) -------------------------------
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Demo Super Admin
SEED_DEMO_PASSWORD=ChangeMe123!
